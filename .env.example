# Povinné
DISCORD_TOKEN=tytoj-token-bota

# Volitelné: když ho zadáš, příkazy se registrují jen v tomto serveru (rychlejší vývoj)
# GUILD_ID=123456789012345678

# ID kanálů / kategorií (odpovídají původnímu botovi, výchozí hodnoty)
# HT3_PANEL_CHANNEL_ID=1511738760377925833
# HT3_TICKET_CATEGORY_ID=1521515658448470066
# TOURNAMENT_RESULT_CHANNEL_ID=1505130493283405884

# Výsledkové kanály rozdělené podle tieru (pošle je tam /result)
# RESULT_CHANNEL_LOWER=1505130409632206888
# RESULT_CHANNEL_UPPER=1505130493283405884

# Kategorie HT3+ ticketů – pro každý kit vlastní kategorie (JSON mapa).
# Klíč = kit (randompot, ironaxe, ...) nebo tier (HT3, LT2, ...).
# Priorita shody: kit -> tier -> HT3_TICKET_CATEGORY_ID.
# HT3_TICKET_CATEGORIES_JSON={"randompot":"1521515658448470066","ironaxe":"123456789012345678"}

# Kanály panelů front – určený kanál pro každý kit (výchozí = originál KIT_CHANNELS).
# Nové přepisy jdou udělat i za běhu přes /addqchannel (data/queue_channels.json).
# QUEUE_CHANNELS_JSON={"randompot":"1523299006925508748","ironaxe":"1511718468221665310"}

# Kategorie pro tester roomky (/mktesterroom). 0 = bez kategorie (nahoře na serveru).
# TESTER_ROOM_CATEGORY_ID=123456789012345678

# Název tester role (stačí, aby ji role obsahovala – case-insensitive)
# TESTER_ROLE_FRAGMENT=tester

# Bezpečnější allowlist testerů podle ID role (čárkou oddělená čísla).
# Když je nastaven, tester se pozná POUZE podle přesného ID role – shoda podle
# názvu (TESTER_ROLE_FRAGMENT) se ignoruje. Doporučeno: vypsat sem skutečné
# ID tester rolí místo názvu.
# TESTER_ROLE_IDS=111111111111111111,222222222222222222

# Role, které smí používat admin příkazy (/addkit, /addtest, /setkitrole,
# /unsetkitrole, /removeplayertiers, /removetest) i bez Discord oprávnění
# Administrator. Když není nastaveno, chová se vše stejně jako dřív –
# přístup má jen kdo má oprávnění Administrator. (Čárkou oddělená čísla.)
# ADMIN_ROLE_IDS=333333333333333333,444444444444444444

# Volitelná synchronizace players.json na GitHub (jako v původním botu s Octokit)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=adrison99
# GITHUB_REPO=DachshundTiers
# GITHUB_FILE_PATH=players.json

# HT Fighty (/topresult) – vyhrazený kanál a role pro veřejné oznámení
# HT Fight výsledků. Obojí je POVINNÉ pro /topresult (jinak vrátí admin chybu).
# Role mention se generuje z TOP_RESULT_ROLE_ID (<@&ID>) – žádná jiná role se
# nepinguje. /topresult nikdy nepoužije RESULT_CHANNEL_LOWER/UPPER.
# TOP_RESULT_CHANNEL_ID=123456789012345678
# TOP_RESULT_ROLE_ID=123456789012345678